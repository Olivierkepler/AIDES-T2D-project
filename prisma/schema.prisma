enum Role {
  ADMIN
  PARTICIPANT
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id        String   @id @default(uuid())
  studyCode String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  user      User?
}

model InviteKey {
  id           String    @id @default(uuid())
  studyCode    String    @unique
  emailAllowed String?
  redeemedAt   DateTime?
  redeemedBy   String?
  createdAt    DateTime  @default(now())
}

model User {
  id            String   @id @default(uuid())
  role          Role     @default(PARTICIPANT)

  participantId String?  @unique
  email         String   @unique
  passwordHash  String
  status        String   @default("active")
  createdAt     DateTime @default(now())

  sessions      Session[]
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // ✅ password reset tokens
  passwordResetTokens PasswordResetToken[]

  // ✅ daily check-ins
  checkIns     CheckIn[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core ratings (0–10)
  distress  Int
  mood      Int      // pleasant ↔ unpleasant (your UI can display reversed)
  energy    Int      // energized ↔ drained

  // Context tags (tap all that fit)
  tags      String[] // Postgres text[]

  // Open-ended responses
  reflection String? @db.VarChar(2000)
  coping     String? @db.VarChar(2000)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
